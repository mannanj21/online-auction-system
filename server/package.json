{
  "name": "auction_system_server",
  "version": "2.0.2",
  "description": "backend for online auction system",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "dev": "nodemon server.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "author": "Mannan Jain",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "node-cron": "^4.2.1",
    "redis": "^6.2.1",
    "resend": "^4.5.1",
    "socket.io": "^4.8.3",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.13",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0",
    "socket.io-parser": "^4.2.6"
  }
}
